# ---------------------------------------------------------------- Auth (Neon)
# Neon Postgres connection string. Create a project at https://neon.tech, then
# apply the schema once:  psql "$DATABASE_URL" -f db/neon-schema.sql
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Generate with:  npx auth secret
AUTH_SECRET=""

# Set this to your deployed origin in production (Vercel sets it automatically
# on preview and production deployments).
# AUTH_URL="https://cybertowers.example.com"

# At least one OAuth provider is needed to sign in. Both are optional; the app
# runs without them, you just cannot create an account.
# Callback URL: {origin}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Callback URL: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --------------------------------------------------------- Game data (MongoDB)
# MongoDB Atlas connection string. Holds profiles, cloud saves and scores.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="cybertowers"
